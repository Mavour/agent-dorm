# Konfigurasi Agent Dorm (salin ke .env lalu sesuaikan)
# Semua komentar dalam Bahasa Indonesia.

# Server HTTP
PORT=8765
HOST=127.0.0.1
LOG_LEVEL=info

# Folder aset pixel-art (jangan diubah kecuali tahu akibatnya)
ASSETS_DIR=./assets_ready

# Kunci dasar HTTP (opsional; kalau diisi, semua halaman/API dilindungi)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Data dianggap basi kalau updatedAt lebih tua dari ini (detik)
STALE_AFTER_SEC=120

# Kontrol demo (tombol DEMO + POST /api/demo/trigger). Hanya untuk mode dummy.
DEMO_CONTROLS=true
# Seed PRNG agar data dummy reproducible
DEMO_SEED=42
# Pengali kecepatan skenario dummy (2 = dua kali lebih cepat)
DEMO_SPEED=1

# --- Mode adapter per agen: dummy | http | file ---
EXITBOT_MODE=dummy
EXITBOT_URL=
EXITBOT_FILE=
EXITBOT_API_KEY=
EXITBOT_POLL_MS=5000

LPWATCHER_MODE=dummy
LPWATCHER_URL=
LPWATCHER_FILE=
LPWATCHER_API_KEY=
LPWATCHER_POLL_MS=5000

ALERT_MODE=dummy
ALERT_URL=
ALERT_FILE=
ALERT_API_KEY=
ALERT_POLL_MS=5000

PORTFOLIO_MODE=dummy
PORTFOLIO_URL=
PORTFOLIO_FILE=
PORTFOLIO_API_KEY=
PORTFOLIO_POLL_MS=5000

# --- Penasihat Karo: rules (aktif) | llm (slot disiapkan, belum aktif) ---
ADVISOR_MODE=rules
# Kunci API LLM (disiapkan untuk nanti; JANGAN diisi / tidak dipakai fase ini)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ADVISOR_MAX_TOKENS=600
